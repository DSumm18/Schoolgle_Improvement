{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "jsx": "react",
    "jsxFactory": "React.createElement"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../../apps/platform/src/test", "../../root_app_backup", "../../apps/platform/src/lib/edwina-voice.ts"]
}
