{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node apps/platform/scripts/ensure-non-production-db.mjs && next dev",
    "dev:uat": "node apps/platform/scripts/run-dev-uat.mjs",
    "db:safety-check": "node apps/platform/scripts/ensure-non-production-db.mjs",
    "supabase:start": "npx supabase start --workdir apps/platform",
    "supabase:status": "npx supabase status --workdir apps/platform",
    "supabase:reset": "npx supabase db reset --workdir apps/platform",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:formfill": "cd packages/form-fill-lab && npm run test",
    "test:formfill:headed": "cd packages/form-fill-lab && npm run test:headed",
    "test:formfill:ci": "cd packages/form-fill-lab && npm run test:ci"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.16.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@supabase/supabase-js": "^2.84.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.183.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "mammoth": "^1.11.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.34.0",
    "next": "16.0.11",
    "officeparser": "^5.2.2",
    "openai": "^6.9.1",
    "pdf2json": "^4.0.0",
    "pdfjs-dist": "^5.4.394",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.160.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
